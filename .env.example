# ── Dokan POS — environment variables ────────────────────────────────────────
# Required: Supabase project credentials (https://supabase.com/dashboard →
# Project Settings → API).
# These are PUBLIC keys (anon key is safe to ship in a client-only SPA).

# Supabase project URL, e.g. https://abcdefgh.supabase.co
VITE_SUPABASE_URL=

# Supabase anon / public key (starts with eyJhbGciOi...)
VITE_SUPABASE_ANON_KEY=

# ── Optional: Vly monitoring toolbar (used by src/instrumentation.tsx) ───────
# Leave empty to disable.
VITE_VLY_APP_ID=
VITE_VLY_MONITORING_URL=

# Local dev:
#   cp .env.example .env.local   → fill in the two VITE_SUPABASE_* values
#   bun run dev
#
# Deployment (Vercel): add the same VITE_SUPABASE_* values in Project →
# Settings → Environment Variables. Keep both environments in sync.